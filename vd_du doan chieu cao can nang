import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error

# 1. Tập dữ liệu chiều cao (x - cm) và cân nặng (y - kg) của 15 người
X = np.array([147, 150, 153, 155, 158, 160, 163, 165, 168, 170, 173, 175, 178, 180, 183], dtype=float)
y = np.array([ 49,  50,  51,  52,  54,  56,  58,  59,  60,  62,  63,  64,  66,  67,  68], dtype=float)

def train_polynomial_regression(X_train, y_train, degree):
    """
    Huấn luyện Hồi quy đa thức bằng công thức ma trận Giả nghịch đảo:
    w = (X_poly^T * X_poly)^(-1) * X_poly^T * y
    """
    # Tạo ma trận đặc trưng đa thức: [1, x, x^2, ..., x^d]
    X_poly = np.vstack([X_train**i for i in range(degree + 1)]).T
    # Tính vector trọng số w
    w = np.linalg.pinv(X_poly) @ y_train
    return w

def predict_polynomial(X_input, w):
    """
    Dự đoán giá trị y dựa trên vector trọng số w và đầu vào X
    """
    X_poly = np.vstack([X_input**i for i in range(len(w))]).T
    return X_poly @ w

def main():
    print("="*65)
    print(" HỒI QUY ĐA THỨC VÀ K-FOLD CROSS-VALIDATION KHẮC PHỤC OVERFITTING")
    print("="*65)

    # Các bậc đa thức d thử nghiệm
    degrees = [1, 2, 4, 8, 12]

    # PHẦN 1: Đánh giá Train MSE trên toàn bộ dữ liệu ---
    print("\n1. ĐÁNH GIÁ SỰ OVERFITTING TRÊN TOÀN BỘ TẬP DỮ LIỆU:")
    for d in degrees:
        w = train_polynomial_regression(X, y, d)
        y_pred = predict_polynomial(X, w)
        mse = mean_squared_error(y, y_pred)
        print(f" - Bậc d = {d:2d} | Train MSE = {mse:10.4f}")

    # PHẦN 2: Khắc phục bằng K-Fold Cross-Validation (K=5) ---
    print("\n2. ĐÁNH GIÁ VỚI 5-FOLD CROSS-VALIDATION (CHỌN BẬC d TỐI ƯU):")
    kf = KFold(n_splits=5, shuffle=True, random_state=42)

    for d in degrees:
        val_mses = []
        for train_idx, val_idx in kf.split(X):
            X_tr, y_tr = X[train_idx], y[train_idx]
            X_val, y_val = X[val_idx], y[val_idx]

            # Huấn luyện trên tập Train
            w = train_polynomial_regression(X_tr, y_tr, d)
            # Dự đoán và tính sai số trên tập Validation
            y_val_pred = predict_polynomial(X_val, w)
            val_mses.append(mean_squared_error(y_val, y_val_pred))

        avg_cv_mse = np.mean(val_mses)
        print(f" - Bậc d = {d:2d} | Trung bình Validation CV MSE = {avg_cv_mse:12.4f}")

    print("\n=> KẾT LUẬN: Bậc d = 1 cho Cross-Validation MSE nhỏ nhất, giúp tránh Overfitting!")

if __name__ == "__main__":
    main()
