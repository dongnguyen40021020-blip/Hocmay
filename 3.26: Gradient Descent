def f(x):
    return x**2 - 4*x + 5

def df(x):
    return 2*x - 4

def gradient_descent_326(x_init=5, lr=0.2, steps=4):
    x = x_init
    print(f"Khởi tạo: x(0) = {x}, f(x) = {f(x)}")
    for i in range(1, steps + 1):
        grad = df(x)
        x = x - lr * grad
        print(f"Bước {i}: x({i}) = {x:.4f}, f(x) = {f(x):.4f}")

gradient_descent_326()
